# ESM.do Docker Compose Environment Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# Application Settings
# =============================================================================

# Environment mode (development, production, test)
NODE_ENV=development

# Enable debug logging
DEBUG=true

# Log level (debug, info, warn, error)
LOG_LEVEL=debug

# =============================================================================
# Port Configuration
# =============================================================================

# ESM.do worker port
ESM_PORT=8787

# Node.js debug port (development only)
DEBUG_PORT=9229

# Redis port
REDIS_PORT=6379

# PostgreSQL port
POSTGRES_PORT=5432

# =============================================================================
# Redis Configuration
# =============================================================================

# Redis connection URL (used by esm-do service)
# Default: redis://redis:6379
REDIS_URL=redis://redis:6379

# =============================================================================
# PostgreSQL Configuration
# =============================================================================

# Database credentials
POSTGRES_USER=esm
POSTGRES_PASSWORD=esm
POSTGRES_DB=esm

# Database connection URL (used by esm-do service)
# Default: postgresql://esm:esm@postgres:5432/esm
DATABASE_URL=postgresql://esm:esm@postgres:5432/esm

# =============================================================================
# Cloudflare/Wrangler Configuration
# =============================================================================

# Wrangler log level (none, error, warn, info, log, debug)
WRANGLER_LOG=debug

# Cloudflare Account ID (optional, for remote features)
# CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API Token (optional, for remote features)
# CLOUDFLARE_API_TOKEN=

# =============================================================================
# Optional Features
# =============================================================================

# Enable/disable Redis caching
# ENABLE_CACHE=true

# Enable/disable PostgreSQL storage
# ENABLE_STORAGE=true

# Cache TTL in seconds (default: 3600)
# CACHE_TTL=3600
