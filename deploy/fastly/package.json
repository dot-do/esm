{
  "name": "@esm-do/fastly-compute",
  "version": "0.0.1",
  "description": "Fastly Compute@Edge deployment for esm.do",
  "private": true,
  "type": "module",
  "main": "bin/index.js",
  "scripts": {
    "build": "npm run clean && npm run build:webpack",
    "build:webpack": "webpack --config webpack.config.js",
    "build:dev": "NODE_ENV=development npm run build",
    "clean": "rm -rf bin",
    "dev": "fastly compute serve --skip-build",
    "serve": "npm run build && fastly compute serve",
    "deploy": "npm run build && fastly compute deploy",
    "deploy:activate": "npm run deploy --activate",
    "validate": "fastly compute validate",
    "publish": "npm run build && fastly compute publish",
    "logs": "fastly log-tail",
    "info": "fastly service describe",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastly/js-compute": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "buffer": "^6.0.3",
    "process": "^0.11.10",
    "ts-loader": "^9.5.0",
    "typescript": "^5.7.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "fastly": {
    "language": "javascript",
    "manifest_version": 3
  }
}
