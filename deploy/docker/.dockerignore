# =============================================================================
# esm.do Docker Ignore
# Patterns for files to exclude from Docker build context
# =============================================================================

# Dependencies - will be installed in container
node_modules/
**/node_modules/

# Build outputs - will be generated in container
dist/
**/dist/
.wrangler/
**/.wrangler/

# Git
.git/
.gitignore
.gitattributes

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# Testing
coverage/
.nyc_output/
*.lcov

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Documentation (not needed for runtime)
docs/
*.md
!README.md
LICENSE

# Development files
.beads/
.claude/
test-*.ts
tests/
vitest.config.ts

# Deploy configs (not needed in container)
deploy/
!deploy/docker/

# Package manager files (except lockfile)
package-lock.json

# Temporary files
tmp/
temp/
*.tmp
*.temp

# OS files
Thumbs.db
ehthumbs.db

# Debug files
*.map
*.tsbuildinfo
