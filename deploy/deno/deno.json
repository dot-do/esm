{
  "name": "@esm-do/deno-deploy",
  "version": "0.0.1",
  "description": "esm.do Deno Deploy configuration",
  "tasks": {
    "dev": "deno run --allow-net --allow-env --watch main.ts",
    "start": "deno run --allow-net --allow-env main.ts",
    "check": "deno check main.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "deploy": "deployctl deploy --project=esm-do --prod main.ts",
    "deploy:preview": "deployctl deploy --project=esm-do main.ts"
  },
  "imports": {
    "@std/http": "jsr:@std/http@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["deno.window", "deno.unstable"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["ban-untagged-todo", "no-unused-vars"],
      "exclude": ["no-explicit-any"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "nodeModulesDir": "auto",
  "unstable": ["kv"],
  "deploy": {
    "project": "esm-do",
    "entrypoint": "main.ts",
    "include": ["main.ts"],
    "exclude": ["README.md", "deploy.sh"]
  }
}
