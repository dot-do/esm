{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/Dockerfile",
    "watchPatterns": [
      "src/**",
      "core/**",
      "package.json",
      "pnpm-lock.yaml",
      "wrangler.jsonc"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "healthcheckPath": "/",
    "healthcheckTimeout": 30
  },
  "service": {
    "internalPort": 8787
  },
  "variables": {
    "NODE_ENV": "production",
    "PORT": "8787",
    "MINIFLARE_LOG_LEVEL": "info"
  }
}
