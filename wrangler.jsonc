{
  // Wrangler configuration for ESM Durable Object
  "name": "esm-do",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-01-01",

  // Enable nodejs_compat for compatibility
  "compatibility_flags": ["nodejs_compat"],

  // Worker loaders for ai-evaluate sandboxed execution
  // See: https://developers.cloudflare.com/workers/runtime-apis/bindings/worker-loader/
  "worker_loaders": [
    { "binding": "loader" }
  ],

  // D1 database for persistent module storage
  // Create with: wrangler d1 create esm-modules
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "esm-modules",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],

  "dev": {
    "port": 8787
  }
}
